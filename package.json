{
  "name": "seme-monorepo",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter seme dev",
    "dev:web": "pnpm --filter seme-web dev",
    "build:api": "pnpm --filter seme build",
    "build:web": "pnpm --filter seme-web build",
    "build": "pnpm run build:api && pnpm run build:web",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.92.0",
    "portless": "^0.17.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,json5,css,scss,html,md,mdx,graphql}": "oxfmt --write"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.23.0"
}
